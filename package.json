{
  "name": "mamones-con-mamones",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler d1 migrations apply mamones-db --remote && wrangler deploy",
    "deploy:staging": "bun run build && wrangler d1 migrations apply mamones-db-staging --env staging --remote && wrangler deploy --env staging",
    "pretest": "bun -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "test": "vitest run && vitest run -c vitest.server.config.ts",
    "test:rules": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "better-auth": "^1.7.2",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "phaser": "^3.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.35.2",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
